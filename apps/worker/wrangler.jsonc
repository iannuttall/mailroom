{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailroom",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "MAX_EMAIL_BYTES": "26214400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailroom",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "mailroom-raw",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "mailroom-ingest",
        "remote": true
      }
    ],
    "consumers": [
      {
        "queue": "mailroom-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 15
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ai_search": [
    {
      "binding": "AI_SEARCH",
      "instance_name": "mailroom",
      "remote": true
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["mailroom@example.com"],
      "remote": true
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md", "**/*.yaml"],
      "fallthrough": true
    }
  ]
}
