{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "MAILROOM_API_TOKEN",
    "MAILROOM_API_URL",
    "MAILROOM_PROFILE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
